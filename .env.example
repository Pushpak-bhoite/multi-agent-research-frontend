# Base URL the browser uses to reach the backend.
# Leave blank in dev so /api requests go through the Vite proxy below.
# Set to the deployed backend origin for production builds, e.g. https://api.example.com
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api requests. Dev only, never shipped to the browser.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
